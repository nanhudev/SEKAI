# CHARACTER line scratch: retarget/render intermediates, per-run probes.
.tmp_assets/
iaido_signature_ceremony.mp4
# The chain ultimate's vertical slice: same rule as the iaido ceremony above.
# The movie and the frames cut from it are review artifacts, regenerated by
# tools/chain_ultimate_renderer.gd + tools/encode_chain_ultimate_movie.sh; the
# sources that produce them are versioned, the renders are not.
chain_ultimate_I_vertical_slice.mp4
chain_ultimate_I_keyframes/

# Python caches (Chat2Blender / audio tools)
__pycache__/
*.pyc

# --- Weapon line: three-tier .blend policy (user ruling 2026-09-29) -------------
# Masters are the source of truth for a family's visual language and the only
# .blend worth versioning; they go in through Git LFS (.gitattributes).
# Everything else under this tree is REGENERABLE from builder + JSON spec, so it
# stays local -- 100+ variant .blend in history is an unmaintainable pile of
# binaries, not an asset library.
#
# Order matters: the broad ignore must come first, the negation after.
assets_source/weapons/**/*.blend
assets_source/weapons/**/*.blend1
!assets_source/weapons/masters/**/*.blend
# Blender's crash/auto-save leftovers, never versioned anywhere.
*.blend[0-9]

# prototypes/ is scratch space: builder output, regenerable from spec in seconds.
# Anything worth keeping gets promoted to masters/ (source) or assets/models
# (shipping GLB) -- so nothing in here is ever the only copy of anything.
assets_source/weapons/prototypes/*
!assets_source/weapons/prototypes/.gitkeep

# asset_sheet.py writes <name>_p.png / <name>_s.png beside the sheet it builds:
# those are the SOURCE renders with a background composited, i.e. the same pixels
# a second time. The plates stay tracked; the composited copies do not.
assets_source/review/**/*_p.png
assets_source/review/**/*_s.png

# UE5 VFX Lab - only hand-authored sources are versioned.
# Intermediate / Saved / Binaries are regenerated by the engine.
ue5_lab/**/Intermediate/
ue5_lab/**/Saved/
ue5_lab/**/Binaries/
ue5_lab/**/DerivedDataCache/
