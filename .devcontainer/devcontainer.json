{
  "name": "SEKAI code development",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {"ghcr.io/devcontainers/features/git-lfs:1": {}},
  "postCreateCommand": "git lfs install && git lfs pull && npm ci",
  "forwardPorts": [5173],
  "remoteEnv": {"SEKAI_ROOT": "${containerWorkspaceFolder}"}
}
