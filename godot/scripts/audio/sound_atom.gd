extends Resource
class_name SoundAtom
## One sound atom: the smallest unit of the SEKAI combat sound language.
##
## An atom is NOT a finished skill sound. It is raw material - air, body,
## cloth, metal, glass, pressure, wind - that gets layered, pitched and timed
## into a cue. New styles, new skills and new spells should be built mostly by
## recombining atoms. Only things that do not exist in reality earn their own
## bespoke render.
##
## See docs/AUDIO_SOUND_LANGUAGE.md for the role of every atom.

@export var id: StringName = &""
@export var category: StringName = &""
## What this atom is FOR, in one line. If a file's name and its role disagree,
## the file gets renamed - the name must never constrain the design.
@export var role := ""
@export var stream: AudioStream
## Perceptual trim. Do not set this by hand - call `apply_trim()`.
@export var base_gain_db := 0.0
## Measured short-term loudness of the file, in dBFS. Comes from
## `atom_loudness_table.gd`, which is GENERATED by
## `audio_source/tools/emit_atom_loudness.py` and can be re-run to refresh it.
@export var loudness_db := 0.0
## False when no measurement was merged in for this id, in which case `apply_trim`
## falls back to the older peak basis instead of guessing.
@export var has_loudness := false
## Small drift only. Sword work needs consistency, not slot-machine audio.
@export var pitch_min := 0.97
@export var pitch_max := 1.03
## Atoms in the same group alternate instead of repeating the same file.
@export var variation_group: StringName = &""
@export var note := ""


func pitch_random(rng: RandomNumberGenerator) -> float:
	return rng.randf_range(pitch_min, pitch_max)


## THE FALLBACK PEAK. Only used when this atom has no loudness row.
const REFERENCE_PEAK_DB := -6.0


## Working trim, from LOUDNESS and not from peak.
##
## This comment used to say "every atom reads at the same loudness and layer gains are
## true RELATIVE values" while the code did `-6.0 - peak`. A peak trim does NOT equalise
## loudness, because the atoms have crest factors from 8.1 dB to 29.7 dB - measured, all
## 157 of them. At the same table gain a dense sub swell (`pressure_low`, crest 8.1) was
## 10.7 dB LOUDER than intended and a small wood crack (`wood_crack`, crest 25.3) was
## 9.3 dB quieter, which is why the swing sounded right and everything it landed on did
## not. The fix is a measured loudness, and the fix is in the code rather than in the
## comment on purpose.
##
## `fallback_peak_db` is the table's recorded peak. It is used only for an atom with no
## loudness row: a missing measurement should degrade to the old behaviour, not to
## silence and not to a random level.
func apply_trim(fallback_peak_db: float) -> void:
	base_gain_db = (REFERENCE_LOUDNESS_DB - loudness_db) if has_loudness \
		else (REFERENCE_PEAK_DB - fallback_peak_db)


## An atom at 0 dB lands here. The value is not a taste decision: it is
## `-6.0 - median(crest)` over the library, i.e. the level at which the MEDIAN atom
## keeps the peak the old formula gave it - so the correction lands on the outliers
## that were actually wrong and barely moves anything that was already tuned.
const REFERENCE_LOUDNESS_DB := -24.8
