var atoms: Dictionary = {}
var groups: Dictionary = {}
## Round-robin cursor per group so variations alternate instead of repeating.
var _cursor: Dictionary = {}
var missing: Array[StringName] = []
## Atoms skipped because `CULLED_ATOMS` says they do not match their siblings. Kept as a
## readable list so a test can assert the cull actually happened instead of trusting the
## counter - a cull that silently stops working is a cue that swings in identity again.
var culled: Array[StringName] = []
## Merged loudness table, loaded once.
var _loudness_cache: Variant = null


func _ready() -> void:
	_build()


func _build() -> void:
	atoms.clear()
	groups.clear()
	missing.clear()
	culled.clear()
	for row in _rows():
		if CULLED_ATOMS.has(row["id"]):
			culled.append(row["id"])
			continue
		var atom := SoundAtom.new()
		atom.id = row["id"]
		atom.category = row["category"]
		atom.role = row["role"]
		atom.variation_group = row["group"]
		atom.note = row.get("note", "")
		atom.pitch_min = row["pitch_min"]
		atom.pitch_max = row["pitch_max"]
		# Hotter files get pulled down, quieter files get pushed up - but on
		# LOUDNESS, not on peak. See SoundAtom.apply_trim: a peak trim could not do
		# this job at all, because crest factors in this library run from 8.1 dB to
		# 29.7 dB and a peak trim treats all of them as equal.
		var measured: Variant = _loudness().get(atom.id)
		if measured == null and row.has("loudness"):
			measured = [float(row["loudness"])]
		if measured != null:
			atom.loudness_db = float((measured as Array)[0])
			atom.has_loudness = true
		atom.apply_trim(float(row["peak"]))
		# The atom carries its own directory. The brief's layout splits atoms by
		# MATERIAL and weapons by WEAPON, so "where is this file" stopped being a
		# constant the moment the library grew past the sword - and a table row
		# that says where its own file is cannot go stale against a moved folder.
		atom.stream = load(String(row.get("dir", CORE_DIR)) + String(row["file"]))
		if atom.stream == null:
			push_warning("Sound atom missing: %s%s" % [
				String(row.get("dir", CORE_DIR)), String(row["file"])])
			continue
		atoms[atom.id] = atom
		if not groups.has(atom.variation_group):
			groups[atom.variation_group] = []
		groups[atom.variation_group].append(atom.id)
	for entry in PENDING_GROUPS:
		var group: StringName = entry["group"]
		if not groups.has(group):
			missing.append(group)


## The sword's original twelve, then whatever the generator emitted. Read through
## the script's constant map rather than a `class_name`, so adding atoms does not
## also mean registering a new global class.
func _rows() -> Array:
	var out: Array = ATOM_TABLE.duplicate()
	var feel_manifest := "res://audio/sfx/weapons/sword/feel_v2/manifest.json"
	if FileAccess.file_exists(feel_manifest):
		var generated: Variant = JSON.parse_string(FileAccess.get_file_as_string(feel_manifest))
		if generated is Array:
			out.append_array(generated)
	if not ResourceLoader.exists(EXT_TABLE_PATH):
		return out
	var script: Variant = load(EXT_TABLE_PATH)
	if script == null:
		return out
	var constants: Dictionary = script.get_script_constant_map()
	if constants.has("ROWS"):
		out.append_array(constants["ROWS"])
	return out


## atom id -> measured loudness, cached because `_build()` asks once per atom and a
## missing table must not turn into a missing sound: an absent row falls back to the
## peak basis inside `SoundAtom.apply_trim`.
func _loudness() -> Dictionary:
	if _loudness_cache != null:
		return _loudness_cache
	_loudness_cache = {}
	if not ResourceLoader.exists(LOUDNESS_TABLE_PATH):
		push_warning("SoundAtomRegistry: no %s - every atom is on the PEAK basis, "
			% LOUDNESS_TABLE_PATH + "which does not equalise loudness")
		return _loudness_cache
	var script: Variant = load(LOUDNESS_TABLE_PATH)
	if script == null:
		return _loudness_cache
	var constants: Dictionary = script.get_script_constant_map()
	if constants.has("LOUDNESS"):
		_loudness_cache = constants["LOUDNESS"]
	return _loudness_cache


func has_group(group: StringName) -> bool:
	return groups.has(group) and not (groups[group] as Array).is_empty()


func group_ids(group: StringName) -> Array[StringName]:
	var ids: Array[StringName] = []
	for atom_id in groups.get(group, []):
		ids.append(atom_id)
	return ids


func atom(id: StringName) -> SoundAtom:
	return atoms.get(id) as SoundAtom


## Alternating pick: A, B, A, B - not random, so a chain never fires the same
## file twice in a row. The atom's own pitch jitter supplies the variation.
func pick(group: StringName, rng: RandomNumberGenerator) -> SoundAtom:
	if not has_group(group):
		return null
	var ids := group_ids(group)
	var index := int(_cursor.get(group, -1)) + 1
	if index >= ids.size():
		index = 0
	_cursor[group] = index
	return atoms.get(ids[index]) as SoundAtom


func atom_count() -> int:
	return atoms.size()


func pending_report() -> String:
	if missing.is_empty():
		return "no pending atoms"
	var lines: PackedStringArray = []
	for entry in PENDING_GROUPS:
		var group: StringName = entry["group"]
		if missing.has(group):
			lines.append("%s %s - want: %s" % [entry["priority"], String(group), entry["want"]])
	return "\n".join(lines)
