		"note": "light sword / fast draw / dodge / short movement slash"},
	{"id": &"air_fast_b", "file": "air_fast_02.wav", "category": &"air",
		"role": "FAST AIR CUT B", "group": &"air_fast", "peak": -6.0,
		"pitch_min": 0.97, "pitch_max": 1.03,
		"note": "alternates with A; never repeat one file through a whole chain"},
	{"id": &"pressure_low", "file": "pressure_low_01.wav", "category": &"pressure",
		"role": "PRESSURE SUB / LOW SWELL", "group": &"pressure_low", "peak": -8.00,
		"pitch_min": 0.96, "pitch_max": 1.02,
		"note": "heavy anticipation / iaido compression / wind force / large movement; NOT a low whoosh"},
	{"id": &"body_low", "file": "body_low_01.wav", "category": &"body",
		"role": "IMPACT BODY LOW", "group": &"body_low", "peak": -9.00,
		"pitch_min": 0.95, "pitch_max": 1.02,
		"note": "heavy hit / guard impact / perfect guard / wall / shatter / collapse; secondary layer, not on every swing"},
	{"id": &"cloth_fast", "file": "cloth_fast_01.wav", "category": &"cloth",
