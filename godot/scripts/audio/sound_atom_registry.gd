	{"id": &"glass_low_tick", "file": "glass_low_tick_01.wav", "category": &"glass",
		"role": "LOW GLASS TICK (demoted)", "group": &"glass_low_tick", "peak": -8.00,
		"pitch_min": 0.97, "pitch_max": 1.03,
		"note": "not crystalline enough to carry the main tick; minor body transient only"},
	{"id": &"wind_pressure", "file": "wind_pressure_01.wav", "category": &"wind",
		"role": "WIND FORCE BODY", "group": &"wind_pressure", "peak": -9.40,
