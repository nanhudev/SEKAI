extends Node
class_name SoundAtomRegistry
## The single place that knows what a sound atom IS.
##
## Gameplay scripts must never `load("res://audio/...")` on their own. They ask
## this registry for a group and get an atom back, with its perceptual trim and
## its pitch range already attached. That is what keeps the combat mix coherent
## when a new style is added: the style re-times and re-layers the same atoms,
## it does not go shopping for new files.

const CORE_DIR := "res://audio/sfx/core/"
## Atoms added after the original twelve. GENERATED by
## `audio_source/tools/emit_godot_atoms.py`, which is also what COPIES the files
## into place - so a new sound is added by generating, processing and re-running
## one tool. Nothing in this file is edited to add a sound, because a registry
## that has to be hand-extended is a registry that silently falls behind the
## library. See docs/AUDIO_LIBRARY.md.
const EXT_TABLE_PATH := "res://scripts/audio/chain_atom_table.gd"
## Measured loudness, one row per atom id. GENERATED by
## `audio_source/tools/emit_atom_loudness.py`. A separate side table keyed by id
## rather than a new column in `chain_atom_table.gd`, because that file is generated
## by a tool a parallel session runs from its own worktree - keeping this in its own
## file means the two writers never disagree about the same file.
const LOUDNESS_TABLE_PATH := "res://scripts/audio/atom_loudness_table.gd"
## The old basis, kept only as the fallback for an atom with no loudness row.
const REFERENCE_PEAK_DB := -6.0

## Atoms measured to be a DIFFERENT SOUND from their own siblings, and therefore not
## offered to the language.
##
## Culled HERE rather than deleted from the table, because the table is GENERATED by
## `emit_godot_atoms.py`: a row removed by hand comes back on the next regeneration,
## and a sound that returns on a rebuild is a bug with no commit to blame.
##
## Criterion (brief section 14): a variant has to be the SAME SOUND as its siblings,
## not merely a legal file, because a cue picks variants round robin - one bad seed is a
## cue that changes identity in one play out of three. Measured per seed with
## `audio_source/tools/atom_bands.py`, then confirmed in the mix with `cue_mix.py`.
## A group of three where two agree is a group where the third is a bug.
##
## Measure the ATTACK, not the file. The first attempt at this list condemned a seed on
## its whole-file centroid, which for a 0.42 s contact is decided by its tail - and this
## family's tails sit 32 dB below their own attack. A metric that averages over a decay
## is a metric that culls for something nobody hears.
const CULLED_ATOMS: Array[StringName] = [
	# 20.0% of its energy below 160 Hz against 1.4% and 1.0% for its two siblings, and
	# the only one of the three that is still the darkest in the mix's first 0.10 s
	# (38.4% low against 17.5% and 25.5%). The other two agree, so this is the bug.
	&"sword_contact_stone_01_A",
]

## Groups that the language already CALLS for but the library does not have
## yet. Declared here on purpose: a cue referencing them stays playable (the
## layer is marked optional), and the gap stays visible instead of silently
## going away.
const PENDING_GROUPS: Array[Dictionary] = [
	{"group": &"glass_high_tick", "priority": "P0",
		"want": "very short / bright / dry / brittle / crystalline / no reverb / no musical tone"},
	{"group": &"glass_tinkle", "priority": "P0",
		"want": "small shards settling, dry, no musical pitch"},
	{"group": &"air_heavy", "priority": "P1",
		"want": "thicker than air_fast, but not a low boom"},
	{"group": &"wood_sheath_tick", "priority": "P1",
		"want": "wood / lacquer scabbard with a tiny metal fitting, dry close-mic"},
]

## id, file, category, role, variation group, measured peak (dBFS), pitch range.
## The measured peak is what produced the file; the registry turns it into a
## trim so nobody has to remember which file was rendered hottest.
const ATOM_TABLE: Array[Dictionary] = [
	{"id": &"air_fast_a", "file": "air_fast_01.wav", "category": &"air",
		"role": "FAST AIR CUT A", "group": &"air_fast", "peak": -6.0,
