[node name="Greybox" type="Node3D" parent="."]
script = ExtResource("2")
; The town boxes are the GATE 1 blockout and the house kit now stands in their
; place. In the landmark layer, Bell Tower / Guild Terrace / North Gate are
; built for real by MistvaleLandmarks and their yellow masses are skipped there
; (see HERO_REPLACED). Ridge Scar / Beacon / Temple Candidate are mountain-side
; and stay greybox: they are the scale reference for the ascent.
show_town = false
show_landmarks = true

