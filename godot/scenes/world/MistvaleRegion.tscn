[sub_resource type="ProceduralSkyMaterial" id="ProceduralSkyMaterial_mistvale"]
sky_top_color = Color(0.38, 0.54, 0.76, 1)
sky_horizon_color = Color(0.76, 0.80, 0.82, 1)
sky_curve = 0.18
ground_bottom_color = Color(0.22, 0.24, 0.25, 1)
ground_horizon_color = Color(0.68, 0.72, 0.72, 1)
; sun_angle_max is the rendered size of the sky's sun DISK, in degrees. It was
; 25.0, which paints a 25-degree yellow slab across the sky — every composition
; render of the ascent came back with a giant disc filling the frame, and it
; would have looked the same in game. 1.2 deg is a sun.
sun_angle_max = 1.2
sun_curve = 0.08

[sub_resource type="Sky" id="Sky_mistvale"]
sky_material = SubResource("ProceduralSkyMaterial_mistvale")

[sub_resource type="Environment" id="Environment_mistvale"]
background_mode = 2
sky = SubResource("Sky_mistvale")
; SKY ambient with a working key light. The earlier ambient had been pushed to
; 1.5 to compensate for the missing sun; with the sun fixed that reads as a
; washed-out sheet, so it comes back down to a sky term.
;
; SOURCE_SKY, NOT SOURCE_COLOR. Measured on the walk rig: with
; ambient_light_source = 2 (COLOR), raising ambient_light_energy from 0.32 to
; 0.55 to 2.0 changed a shadowed street by 0.0 luminance — the COLOR path
; contributes nothing under this renderer, so the scene had NO ambient at all
; and every shadow was lit only by the Bounce fill. That is why the upper town
; came back at luminance 13 against 62 for the same stones in sun.
ambient_light_source = 3
ambient_light_sky_contribution = 1.0
ambient_light_energy = 0.55
; FILMIC, not AGX: the project renders with gl_compatibility (see
; BLACK_SCREEN_DIAGNOSIS.md) and AgX is not applied there, so an AGX setting is
; a silent no-op that makes the render look under-exposed forever.
tonemap_mode = 2
tonemap_exposure = 0.62
tonemap_white = 2.0
; Mistvale reads as a humid river valley: light fog, cool, drifting toward
; cold on the north mountain. Tuned for legibility at 600 m, not for beauty —
; GATE 5 owns the real atmosphere pass.
fog_enabled = true
fog_light_color = Color(0.74, 0.79, 0.83, 1)
fog_light_energy = 0.9
fog_density = 0.0018
fog_aerial_perspective = 0.55
fog_sky_affect = 0.35

[sub_resource type="CapsuleShape3D" id="WalkerShape"]
radius = 0.35
height = 1.8

[node name="MistvaleRegion" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_mistvale")

[node name="Sun" type="DirectionalLight3D" parent="."]
; THE SUN WAS BELOW THE HORIZON.
;
; A DirectionalLight3D shines along -basis.z. The previous basis had
; basis.z = (-0.51, -0.69, 0.51), so the light travelled along
; (+0.51, +0.69, -0.51) — a ray with a POSITIVE Y component, i.e. upwards.
; Every up-facing surface in the region therefore failed N.L and received no
; sun at all: the whole valley was lit by the blue ambient term alone, which is
; why every render of this map came back flat, cold and about 4x too dark, and
; why the previous pass "fixed" it by pushing ambient to 1.5 and calling the
; result over-exposed.
;
; Diagnosed by measuring, not by reading: a flat #808080 test surface under the
; rig rendered at (51,61,71) — ambient-only shading, no key light.
;
; This basis is the south-east sun at 44 deg elevation that the masterplan's
; colour story assumes: basis.z points back toward the sun at
; (0.60, 0.70, 0.40), so the light travels (-0.60, -0.70, -0.40) — down, and
; from the south-east toward the north-west.
transform = Transform3D(0.56, 0, -0.84, -0.588, 0.714, -0.392, 0.6, 0.7, 0.4, 0, 0, 0)
light_energy = 1.10
light_indirect_energy = 0.45
shadow_enabled = true
directional_shadow_max_distance = 220.0
directional_shadow_fade_start = 0.8
; The terrain opts out of casting (see mistvale_terrain.gd), so the bias only
; has to cover props standing on the ground, not a heightfield shadowing itself.
shadow_bias = 0.08
shadow_normal_bias = 2.5

[node name="Bounce" type="DirectionalLight3D" parent="."]
; THE SKY-BOUNCE FILL.
;
; WHY IT HAS TO EXIST: with one key light from the south-east, every surface
; whose normal points north or west fails N.L and receives ambient only. That
; is not a corner case in this map — it is the entire north face of the town
; hill. Measured: R06 (Guild Terrace, looking north) came back at luminance 26
; against 117 for the same scene looking south, i.e. 90% of the frame was
; unreadable black. Ambient at 0.32 cannot carry a whole aspect of the map.
;
; WHY A DIRECTIONAL FILL AND NOT MORE AMBIENT: ambient is directionless, so
; raising it lifts the lit side too and flattens the key. A second light aimed
; from the opposite aspect lifts only the faces that are losing, which is
; exactly the set that needs it.
;
; basis.z = (-0.45, 0.60, -0.66): the light sits to the north-west and 37 deg
; up, so -basis.z.y = -0.60 is negative and the light travels DOWNWARD. Check
; this sign with the sun: a positive -basis.z.y means the light points at the
; sky and nothing is lit at all.
transform = Transform3D(-0.826, 0, 0.563, 0.338, 0.799, 0.496, -0.45, 0.6, -0.66, 0, 0, 0)
light_energy = 0.40
light_color = Color(0.66, 0.75, 0.95, 1)
shadow_enabled = false
light_negative = false

[node name="Terrain" type="Node3D" parent="."]
