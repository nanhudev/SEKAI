; `spawn_chain_director = false` — the first playable is a town square with one
; sword in it, and the chain system would mount a second weapon, a second audio
; director and a second set of debug keys into it. §26 rules the chain out.
[node name="CombatAudioDirector" type="Node" parent="."]
process_mode = 3
script = ExtResource("10")
spawn_chain_director = false

; Silence until §19. `AudioStateController` finds it by name, and the director
; starts it on the frame the hound arrives — which is why this is a plain player
; and not `combat_music.gd`, whose `_ready` autoplays.
[node name="CombatMusic" type="AudioStreamPlayer" parent="."]
stream = ExtResource("26")
volume_db = -11.0

; ----------------------------------------------------------- the story layer
[node name="StoryUI" type="CanvasLayer" parent="."]
layer = 10
script = ExtResource("19")

; THE DIRECTOR'S SIX PATHS ARE NOT OPTIONAL AND WERE EMPTY ON THE FIRST WRITE.
; `StoryDirector._resolve()` reads each one with `get_node_or_null()` and pushes a
; named warning for a null, so an unwired director does not crash - it warns,
; resolves nothing, and then plays a ten-minute sequence to an empty square with
; no NPC, no rack and no stele in it. Every path below is `../` because the
; director is a sibling of everything it points at, not their parent.
[node name="StoryDirector" type="Node" parent="."]
script = ExtResource("20")
npc_path = NodePath("../Mira")
rack_path = NodePath("../SwordRack")
post_path = NodePath("../TrainingPost")
stele_path = NodePath("../Stele")
player_path = NodePath("../Player")
enemy_spawn_path = NodePath("../AlleyMouth")
enemy_scene = ExtResource("25")
music_path = NodePath("../CombatMusic")
