; THE DUMMY HAD NO MATERIAL AT ALL.
;
; It shipped as Godot's default StandardMaterial3D — pure 0.8 grey — which under
; this arena's near-horizontal sun renders it at the same luminance as the floor
; it stands on and the blocks behind it. Measured on the PASS 4 movie the body,
; the RaisedPlatform's top face and the far wall all landed inside a 30-luma
; band, so the target the whole execution system exists for had no SILHOUETTE:
; nothing to see it against, and therefore nothing to see it cut in half
; against. These two are 训练场的构造体壳层, and their job is to be a target:
; a stone that is clearly darker than the ground, and a slightly lighter collar
; where the core sits, so the body has an internal edge for the wound to cross.
[sub_resource type="StandardMaterial3D" id="DummyShell"]
albedo_color = Color(0.40, 0.385, 0.355, 1)
roughness = 0.86
metallic = 0.0

; Deliberately not emissive. A training dummy that glows is a different kind of
; object, and the construct's core light belongs to the CROSS-SECTION (see
; IaidoExecutionLibrary.SURFACES core_emission), not to the closed body.
[sub_resource type="StandardMaterial3D" id="DummyCore"]
albedo_color = Color(0.585, 0.565, 0.515, 1)
roughness = 0.62
metallic = 0.0

[sub_resource type="CylinderMesh" id="BodyMesh"]
top_radius = 0.65
