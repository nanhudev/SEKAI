; DRILL DUMMY — the small, unkillable training target.
;
; WHY IT IS SMALLER
; The arena's construct is 2.1 m and reads as a body you fight. This one is 1.5 m and
; reads as a body you PRACTISE on, which is exactly the distinction the user asked for
; (加一个小一点的假人). The size difference is not decoration: a smaller hurtbox means
; the sword's arc has to be aimed rather than merely swung, so the target stays useful
; after the first successful hit.
;
; WHY IT IS DARKER THAN THE COURT
; The same reasoning as the range target's shell: a body at the same luminance as the
; floor it stands on has no silhouette, and a struck body with no silhouette cannot be
; seen to be struck. The court pad here is STONE_COURT (0.44, 0.44, 0.47); this shell is
; a warm dark timber-bronze, so the hit reaction has an edge to happen against.
;
; The script is a SUBCLASS of the construct, not a copy of it. See drill_dummy.gd for
; why the difference is a subclass rather than a flag on the enemy.

[sub_resource type="StandardMaterial3D" id="DrillShell"]
albedo_color = Color(0.335, 0.30, 0.255, 1)
roughness = 0.88
metallic = 0.0

; The collar is deliberately a little BRIGHTER and a little warmer than the shell, so
; the body has an internal edge for a wound or a stagger to cross. Not emissive: this
; is a practice post, not a construct with a running core.
[sub_resource type="StandardMaterial3D" id="DrillCollar"]
albedo_color = Color(0.60, 0.54, 0.42, 1)
roughness = 0.60
metallic = 0.0

[sub_resource type="CylinderMesh" id="BodyMesh"]
top_radius = 0.45
bottom_radius = 0.62
height = 1.1

[sub_resource type="SphereMesh" id="CoreMesh"]
radius = 0.29
height = 0.58

[sub_resource type="CylinderShape3D" id="BodyShape"]
radius = 0.55
height = 1.1

[sub_resource type="BoxShape3D" id="AttackShape"]
size = Vector3(1.2, 1.05, 1.4)

[node name="DrillDummy" type="StaticBody3D" groups=["hostiles"]]
script = ExtResource("1")

[node name="Body" type="MeshInstance3D" parent="."]
