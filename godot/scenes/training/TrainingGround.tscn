[gd_scene load_steps=24 format=3]

; LD-02 SEKAI TRAINING GROUND - the art review hub.
; Owned by the ART line. Design authority: this header and
; docs/ART_INTEGRATION_REQUESTS.md.
;
; WHAT IT IS
; One scene that answers "what does SEKAI's art look like right now". Spawn,
; take a weapon off a rack, hit something, walk the movement lane, throw an
; effect on the VFX stage, look at the whole environment kit, then walk through
; the gate into Mistvale - without closing anything.
;
; HOW IT DIFFERS FROM CombatSandbox
; CombatSandbox is a 24 x 24 arena whose dummy stands on the walking line, so it
; can answer questions about fighting and about nothing else. This is a 90 x 80
; compound of separate zones, which is what makes it usable as a review space:
; movement is not obstructed by a target, a 20 m chain has room, and the VFX
; stage is neutrally lit with a reference grid.
;
; The heavy directors (Iaido, Moment of No Moon, screen FX, audio) are carried
; over from CombatSandbox unchanged, because the VFX stage has to be able to run
; the same effects the game runs, or it is not reviewing anything.
;
; WHAT THIS SCENE DOES NOT TOUCH
; Player.tscn, combat_controller.gd, the weapon state machine and the Iaido
; director are MAIN / COMBAT files. The two integration points this scene needs
; from them are written up in docs/ART_INTEGRATION_REQUESTS.md and are NOT
; applied here, so that ART never edits a file another session is holding open.

[ext_resource type="PackedScene" path="res://scenes/player/Player.tscn" id="1_player"]
[ext_resource type="Script" path="res://scripts/combat/developer_panel.gd" id="2_devpanel"]
[ext_resource type="Script" path="res://scripts/combat/time_effect_manager.gd" id="3_timefx"]
[ext_resource type="Script" path="res://scripts/combat/combat_screen_fx.gd" id="4_screenfx"]
[ext_resource type="Script" path="res://scripts/training/training_ground.gd" id="5_ground"]
[ext_resource type="PackedScene" path="res://scenes/ui/CombatHUD.tscn" id="6_hud"]
[ext_resource type="Script" path="res://scripts/systems/audio_state_controller.gd" id="7_audio_state"]
[ext_resource type="Script" path="res://scripts/combat/iaido_director.gd" id="8_iaido"]
[ext_resource type="Script" path="res://scripts/combat/iaido_target_collector.gd" id="9_iaido_targets"]
[ext_resource type="Script" path="res://scripts/combat/iaido_tear_3d.gd" id="10_iaido_tear"]
[ext_resource type="Script" path="res://scripts/combat/iaido_screen_fx.gd" id="11_iaido_fx"]
[ext_resource type="Script" path="res://scripts/combat/world_pause_manager.gd" id="12_pause"]
[ext_resource type="Script" path="res://scripts/player/foreground_weapon_layer.gd" id="13_fgweapon"]
[ext_resource type="Script" path="res://scripts/combat/iaido_glass_layer.gd" id="14_glass"]
[ext_resource type="Script" path="res://scripts/combat/iaido_audio_timeline.gd" id="15_iaido_audio"]
