[ext_resource type="Script" path="res://scripts/audio/combat_audio_director.gd" id="18_audiodir"]
[ext_resource type="Script" path="res://scripts/training/training_ground_ui.gd" id="19_ui"]
[ext_resource type="Script" path="res://scripts/systems/movement_lane.gd" id="20_movelane"]

[sub_resource type="ProceduralSkyMaterial" id="SkyMaterial_training"]
sky_top_color = Color(0.3, 0.5, 0.78, 1)
sky_horizon_color = Color(0.78, 0.82, 0.84, 1)
sky_curve = 0.15
ground_bottom_color = Color(0.3, 0.29, 0.28, 1)
ground_horizon_color = Color(0.62, 0.62, 0.6, 1)
sun_angle_max = 1.2
sun_curve = 0.1

[sub_resource type="Sky" id="Sky_training"]
sky_material = SubResource("SkyMaterial_training")

[sub_resource type="Environment" id="Environment_training"]
background_mode = 2
sky = SubResource("Sky_training")
ambient_light_source = 3
ambient_light_sky_contribution = 1.0
ambient_light_energy = 0.5
tonemap_mode = 4
tonemap_white = 1.0
fog_enabled = false

[node name="TrainingGround" type="Node3D"]
process_mode = 1

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_training")

; Sun belongs to the scene, not to the ui: the DAY/NEUTRAL toggle in
; training_ground_ui.gd switches ambient source and sun energy at runtime.
; 2.0 sun + 1.0 ambient on a 0.62-albedo pad clipped the whole floor to white,
; which makes every material judgement worthless - the reviewer ends up
; reviewing the light rig. AgX (4) + 1.2 sun + 0.5 ambient puts mid-grey back
; at mid-grey. Matches the discipline in assets/chat2blender/render_stair_review.py.
[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.86, -0.42, 0.29, 0, 0.6, 0.8, -0.51, -0.69, 0.51, 0, 0, 0)
light_energy = 1.2
light_indirect_energy = 0.4
shadow_enabled = true
directional_shadow_max_distance = 120.0

; The compound: ground, parapet, spine, zones A-G, review anchors. All of it is
; built in code so that one number (a zone rectangle) is the only place a zone's
; position is written down.
[node name="Ground" type="Node3D" parent="."]
script = ExtResource("5_ground")

; MovementLane is COMBAT's stage and is instanced unchanged. It owns its deck
; plane, kerbs and distance markings; the training ground only adds the stairs
; and turn the brief asks for that it does not already have.
[node name="MovementLane" type="Node3D" parent="."]
script = ExtResource("20_movelane")

[node name="Player" parent="." instance=ExtResource("1_player")]

